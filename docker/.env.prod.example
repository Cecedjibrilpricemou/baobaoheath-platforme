# Gabarit des secrets de PRODUCTION (docker/docker-compose.prod.yml).
#
# Copiez-le en docker/.env.prod — ignore par git — et remplissez chaque ligne.
# **N'ecrivez jamais de vraie valeur dans ce fichier-ci** : il est suivi, et le
# depot est public. Toute variable obligatoire laissee vide fait refuser le
# demarrage par `docker compose`.
#
# Generer un secret : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ─── Base de donnees ──────────────────────────────────────────────
POSTGRES_DB=keneya
POSTGRES_USER=keneya
POSTGRES_PASSWORD=
# Port de Postgres sur 127.0.0.1 du serveur (tunnel SSH pour les migrations).
POSTGRES_PORT_LOCAL=5432

# ─── Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ─── Jetons et chiffrement ────────────────────────────────────────
# Deux secrets distincts, 64 caracteres ou plus.
JWT_SECRET=
JWT_REFRESH_SECRET=
# 64 caracteres hexadecimaux. **Identique partout ou la meme base est lue** :
# une autre cle rend illisibles les champs deja chiffres.
DB_ENCRYPTION_KEY=

# ─── Adresses publiques (HTTPS) ───────────────────────────────────
ALLOWED_ORIGINS=https://
FRONTEND_URL=https://
WEB_PORT=8080

# ─── E-mail : indispensable, il porte les codes OTP des professionnels ──
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── Facultatif ───────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
USSD_HMAC_KEY=
USSD_ALLOWED_IPS=
CHAPCHAP_API_KEY=
CHAPCHAP_HMAC_KEY=
CHAPCHAP_CALLBACK_URL=
