# Copy to docker/.env (gitignored) before running `docker compose up --build`.
# Postgres/Redis connection details are wired directly in docker-compose.yml —
# only secrets/overrides for the api container go here.

JWT_SECRET=VOTRE_SECRET_JWT_64_CARACTERES_MIN
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# 32 octets en hex (64 caracteres) — generer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=VOTRE_CLE_HEX_64_CARACTERES
ALLOWED_ORIGINS=http://localhost:8080
FRONTEND_URL=http://localhost:8080
GMAIL_USER=
GMAIL_APP_PASSWORD=
LOG_LEVEL=info
