model Medicament {
  id String @id @default(cuid())

  /// Le nom affiche partout, quelle que soit la categorie. Jusqu'au
  /// 2026-10-01 chaque ecran recomposait `nomCommercial ?? dci`, ce qui ne
  /// veut rien dire pour un lait infantile.
  libelle String

  /// Denomination commune internationale. Absente hors medicament : un lait
  /// infantile n'en a pas. La contrainte SQL `medicaments_medicament_complet`
  /// garantit qu'un MEDICAMENT en porte une.
  dci           String?
  nomCommercial String?
  forme         String?
  dosage        String?

  /// Ce que le produit est, en liste fermee. Porte les exclusions d'assurance
  /// et interdit la prescription de ce qui n'est pas un medicament.
  categorie CategorieProduit @default(MEDICAMENT)

  /// Classe therapeutique en texte libre (« Antalgique »), tant que le
  /// referentiel national (D6) n'est pas arrete. Autre axe que `categorie`.
  classeTherapeutique String?

  imageUrl         String?
  listeEssentielle Boolean @default(false)
  estActif         Boolean @default(true)
  prixUnitaireGnf  Int     @default(0) // prix national de reference en GNF

  // Classification ATC (EF-05-05, decision D6). Elle permet de rapprocher deux
  // specialites de la meme famille : un patient allergique a l'amoxicilline
  // l'est a toute la classe J01C, que la comparaison sur la DCI seule
  // manquerait.
  codeAtc String?

  /// Produit a circuit reglemente : stupefiant, psychotrope (EF-05-12). Une
  /// ordonnance qui en contient n'est jamais renouvelable, sa validite est
  /// reduite, et elle exige la signature d'un medecin quelle que soit la
  /// decision D2.
  estReglemente Boolean @default(false)

  /// Contre-indications connues, en texte libre tant que le referentiel
  /// national (D6) n'est pas arrete. Comparees aux maladies chroniques du
  /// patient (EF-05-06).
  contreIndications String[]

  lignesOrdonnance LigneOrdonnance[]
  stocks           Stock[]
  lignesVente      LigneVente[]

  @@index([codeAtc])
  @@index([categorie])
  @@map("medicaments")
}

// Gravite d'une interaction, du plus leger au plus grave. L'ordre des valeurs
// fait foi : le service compare par rang pour decider ce qui merite un motif
// de depassement.
enum NiveauInteraction {
  PRECAUTION
  ASSOCIATION_DECONSEILLEE
  CONTRE_INDICATION
}

/// Interaction connue entre deux principes actifs (EF-05-05).
///
/// Une interaction est symetrique : le couple est toujours stocke ordonne
/// (dciA < dciB, en minuscules) pour qu'une meme paire ne puisse pas exister
/// deux fois dans les deux sens.
model InteractionMedicament {
  id          String            @id @default(cuid())
  dciA        String
  dciB        String
  niveau      NiveauInteraction
  description String
  /// Conduite a tenir, affichee au prescripteur avec l'alerte.
  conduite    String?
  /// Referentiel d'origine, pour pouvoir reexaminer une regle contestee.
  source      String?
  creeLe      DateTime          @default(now())

  @@unique([dciA, dciB])
  @@index([dciA])
  @@index([dciB])
  @@map("interactions_medicaments")
}

// L'ordonnance est un *document* : un numero unique, un code de verification
// remis au patient, une date de fin de validite. C'est lui que la pharmacie
// controle avant de delivrer quoi que ce soit (EF-05-07/08, EF-07-01). Les
// medicaments prescrits sont ses lignes.
model Ordonnance {
  id     String           @id @default(cuid())
  numero String           @unique // OR-2026-000123
  statut StatutOrdonnance @default(EN_ATTENTE)

  // Court, sans caracteres ambigus, lu a voix haute ou recopie depuis le
  // papier. Il ne remplace pas le numero : il prouve que le porteur a bien
  // l'ordonnance en main, le numero seul etant devinable.
  codeVerification String

  // Au-dela, la pharmacie refuse. La duree par defaut est un parametre
  // systeme, jamais une constante (decision D2 du cahier des charges).
  valideJusquau DateTime

  // EF-05-09 : nombre de fois que l'ordonnance peut etre servie a nouveau
  // apres avoir ete entierement delivree. Le numero et le code ne changent
  // pas â€” c'est le meme papier que le patient represente au comptoir.
  renouvellementsAutorises Int @default(0)
  renouvellementsUtilises  Int @default(0)

  urlDocument String?
  creeLe      DateTime @default(now())
  modifieLe   DateTime @updatedAt

  idConsultation String
  consultation   Consultation @relation(fields: [idConsultation], references: [id], onDelete: Cascade)

  // Signature nominative du prescripteur : sans elle, l'ordonnance n'est pas
  // opposable et la pharmacie doit la refuser.
  signePar   String?
  signataire Utilisateur? @relation("MedecinSignataire", fields: [signePar], references: [id])
  signeLe    DateTime?

  lignes         LigneOrdonnance[]
  ventesComptoir VenteComptoir[]
  commande       Commande?

  @@index([idConsultation])
  @@index([statut])
  @@index([valideJusquau])
  @@map("ordonnances")
}

// Un medicament prescrit. La delivrance se fait ligne par ligne : une
// pharmacie peut n'avoir qu'une partie du traitement (delivrance partielle,
// EF-07-07), et le statut du document se deduit de ses lignes.
model LigneOrdonnance {
  id           String           @id @default(cuid())
  posologie    String
  frequence    String
  dureeJours   Int
  quantite     Int              @default(1)
  instructions String?
  statut       StatutOrdonnance @default(EN_ATTENTE)
  creeLe       DateTime         @default(now())

  // EF-05-06 : les alertes presentees au prescripteur au moment de la
  // prescription, figees telles quelles. Le referentiel evoluera ; ce qui
  // compte est ce qui lui a ete montre ce jour-la.
  alertes Json?

  /// Pourquoi le prescripteur a passe outre. Nul quand aucune alerte n'a
  /// ete declenchee, ou quand il n'a pas motive son choix.
  motifDepassement String?

  idOrdonnance String
  ordonnance   Ordonnance @relation(fields: [idOrdonnance], references: [id], onDelete: Cascade)

  idMedicament String
  medicament   Medicament @relation(fields: [idMedicament], references: [id])

  @@index([idOrdonnance])
  @@index([statut])
  @@map("lignes_ordonnance")
}

model Vaccination {
  id             String    @id @default(cuid())
  vaccinNom      String
  codeEpi        String?
  numeroLot      String?
  siteInjection  String?
  reaction       String?
  urlCertificat  String?
  dateProchaineD DateTime?
  administreLe   DateTime  @default(now())

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  idAdministrePar String
  administrePar   Utilisateur @relation(fields: [idAdministrePar], references: [id])

  @@index([idPatient, administreLe(sort: Desc)])
  @@index([dateProchaineD])
  @@map("vaccinations")
}

// â”€â”€â”€ DOMAINE 4 â€” COORDINATION â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// Ou en est la demande qu'un patient a faite depuis chez lui.
enum StatutDemandeRendezVous {
  EN_ATTENTE // personne ne l'a encore prise
  ACCEPTEE // un medecin a fixe un creneau ; l'episode est ouvert
  REFUSEE // avec un motif, que le patient lit
  ANNULEE // le patient s'est ravise
}

/// Demande de rendez-vous faite a distance (addendum du 2026-09-28, point 6).
///
/// Le patient n'ouvre pas un episode de soins : un episode est une visite, et
/// une demande n'en est pas encore une. Elle devient un episode le jour ou un
/// medecin l'accepte, et pas avant — sinon la file de l'hopital se remplirait
/// de visites qui n'auront jamais lieu.
model DemandeRendezVous {
  id        String                  @id @default(cuid())
  motif     String
  statut    StatutDemandeRendezVous @default(EN_ATTENTE)
  creeLe    DateTime                @default(now())
  modifieLe DateTime                @updatedAt

  traiteeLe  DateTime?
  motifRefus String?

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  idStructure String
  structure   StructureSante @relation("DemandesRendezVous", fields: [idStructure], references: [id])

  /// Le medecin que le patient souhaite, s'il en connait un. Sinon l'accueil
  /// oriente la demande : c'est son metier, et le seul qu'il garde ici.
  idMedecin String?
  medecin   Utilisateur? @relation("DemandesRendezVousMedecin", fields: [idMedecin], references: [id])

  idTraitePar String?
  traitePar   Utilisateur? @relation("DemandesRendezVousTraitees", fields: [idTraitePar], references: [id])

  /// Rempli a l'acceptation : la demande devient une visite.
  idEpisode String?       @unique
  episode   EpisodeSoins? @relation(fields: [idEpisode], references: [id])

  @@index([idPatient, creeLe(sort: Desc)])
  /// File du medecin : les demandes qui le visent et attendent.
  @@index([idMedecin, statut])
  /// File de l'accueil : celles de sa structure que personne ne vise.
  @@index([idStructure, statut])
  @@map("demandes_rendez_vous")
}

/// Le cycle d'un rendez-vous, de la prise au depart du patient.
///
/// C'etait une chaine libre jusqu'au 2026-09-30 : la base n'interdisait aucune
/// valeur, et `asc.service.ts` comptait des rendez-vous `HONORE` que personne
/// n'ecrivait jamais â€” la statistique valait structurellement zero.
enum StatutRendezVous {
  PLANIFIE // le medecin a fixe le creneau (addendum, point 3)
  PRESENT // l'assistante a pointe l'arrivee du patient
  EN_CONSULTATION // le medecin a pris le patient
  TERMINE // consultation faite â€” remplace l'ancien Â« HONORE Â»
  ABSENT // le patient n'est pas venu
  ANNULE // remplace par un autre rendez-vous, ou annule
}

model RendezVous {
  id        String           @id @default(cuid())
  statut    StatutRendezVous @default(PLANIFIE)
  motif     String?
  prevuLe   DateTime
  rappel24h Boolean          @default(false)
  rappel2h  Boolean          @default(false)
  creeLe    DateTime         @default(now())
  modifieLe DateTime         @updatedAt

  /// Pointage de l'arrivee par l'assistante (addendum, point 2). C'est le
  /// moment ou l'attente commence, et il n'a rien a voir avec `prevuLe` : un
  /// patient arrive en avance ou en retard.
  arriveeLe   DateTime?
  idPointePar String?
  pointePar   Utilisateur? @relation("PointageArrivee", fields: [idPointePar], references: [id])

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  idAsc String?
  asc   AscProfile? @relation(fields: [idAsc], references: [id])

  // Orientation vers un medecin depuis l'accueil (EF-03-05)
  idMedecin String?
  medecin   Utilisateur? @relation("RendezVousMedecin", fields: [idMedecin], references: [id])

  idEpisode String?
  episode   EpisodeSoins? @relation(fields: [idEpisode], references: [id])

  idConsultation String?       @unique
  consultation   Consultation? @relation(fields: [idConsultation], references: [id])

  @@index([idPatient])
  @@index([idAsc])
  @@index([idMedecin, prevuLe])
  @@index([idEpisode])
  @@index([prevuLe, statut, rappel24h])
  @@map("rendez_vous")
}

model Referencement {
  id             String         @id @default(cuid())
  urgence        Urgence        @default(ROUTINE)
  statut         ReferralStatus @default(EN_ATTENTE)
  resumeClinique String
  motifRefus     String?
  urlDocument    String?
  creeLe         DateTime       @default(now())
  reponduLe      DateTime?

  idConsultation String       @unique
  consultation   Consultation @relation(fields: [idConsultation], references: [id], onDelete: Cascade)

  idStructureSource String?
  structureSource   StructureSante? @relation("StructureSource", fields: [idStructureSource], references: [id])

  idStructureCible String
  structureCible   StructureSante @relation("StructureCible", fields: [idStructureCible], references: [id])

  idMedecinValideur String?
  medecinValideur   Utilisateur? @relation("MedecinValideurRef", fields: [idMedecinValideur], references: [id])

  @@index([idStructureCible, statut])
  @@index([creeLe])
  @@map("referencements")
}

model Message {
  id       String    @id @default(cuid())
  contenu  String
  lu       Boolean   @default(false)
  luLe     DateTime?
  envoyeLe DateTime  @default(now())

  idExpediteur String
  expediteur   Utilisateur @relation("Expediteur", fields: [idExpediteur], references: [id], onDelete: Restrict)

  idDestinataire String
  destinataire   Utilisateur @relation("Destinataire", fields: [idDestinataire], references: [id], onDelete: Restrict)

  idConsultation String?
  consultation   Consultation? @relation(fields: [idConsultation], references: [id])

  @@index([idDestinataire, lu])
  @@index([idExpediteur])
  @@map("messages")
}

// â”€â”€â”€ DOMAINE 5 â€” GESTION OPERATIONNELLE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Stock {
  id          String   @id @default(cuid())
  /// Le total, somme des lots encore disponibles. Il reste porte ici : le
  /// decrement conditionnel de la delivrance s'appuie dessus, et le recalculer
  /// a chaque lecture couterait cher pour rien.
  quantite    Int      @default(0)
  seuilAlerte Int      @default(10)
  unite       String
  margeGnf    Int      @default(0) // Marge appliquee par la pharmacie
  modifieLe   DateTime @updatedAt

  idAsc String?
  asc   AscProfile? @relation(fields: [idAsc], references: [id], onDelete: Restrict)

  idStructure String?
  structure   StructureSante? @relation(fields: [idStructure], references: [id], onDelete: Restrict)

  idMedicament String
  medicament   Medicament @relation(fields: [idMedicament], references: [id])

  /// Le detail par lot (addendum du 2026-09-28, point 1.3). `datePeremption`
  /// etait porte sur le stock jusqu'au 2026-09-30 : une seule date par produit
  /// et par officine, alors qu'un approvisionnement apporte des lots aux
  /// peremptions differentes. Le modele ecrasait l'une des deux dates, et le
  /// stock affichait une peremption fausse.
  lots LotStock[]

  @@unique([idAsc, idMedicament])
  @@unique([idStructure, idMedicament])
  @@map("stocks")
}

/// Entree en stock, telle que la facture du fournisseur la decrit
/// (addendum du 2026-09-28, point 1.3).
///
/// En deux temps, a dessein : ici la saisie assistee, avec la facture attachee
/// en justificatif. L'extraction automatique viendra ensuite, et devra
/// toujours etre relue avant enregistrement — une erreur sur une quantite ou
/// une peremption entrerait sinon en silence dans le stock d'un medicament.
model Approvisionnement {
  id              String   @id @default(cuid())
  numero          String   @unique
  /// Reference de la facture chez le fournisseur, telle qu'elle y figure.
  numeroFacture   String?
  fournisseur     String
  dateFacture     DateTime
  /// Photo ou scan de la facture : la piece qui justifie l'entree.
  justificatifUrl String?
  montantTotalGnf Int      @default(0)
  creeLe          DateTime @default(now())

  idStructure String
  structure   StructureSante @relation("ApprovisionnementsStructure", fields: [idStructure], references: [id], onDelete: Restrict)

  idSaisiPar String
  saisiPar   Utilisateur @relation("ApprovisionnementsSaisis", fields: [idSaisiPar], references: [id], onDelete: Restrict)

  lots LotStock[]

  @@index([idStructure, dateFacture(sort: Desc)])
  @@map("approvisionnements")
}

/// Un lot recu : une quantite, une date de peremption, une origine.
///
/// C'est lui qui rend possible la sortie au plus proche de la peremption
/// plutot qu'au hasard — la regle attendue dans une pharmacie — et l'alerte
/// sur les lots qui approchent de leur date.
model LotStock {
  id             String    @id @default(cuid())
  /// Numero de lot du fabricant, quand la boite le porte.
  numeroLot      String?
  /// Ce qui reste de ce lot. Un lot a zero est garde : il porte la trace de
  /// ce qui est entre et de ce qui est sorti.
  quantite       Int
  quantiteRecue  Int
  datePeremption DateTime?
  prixAchatGnf   Int       @default(0)
  creeLe         DateTime  @default(now())
  modifieLe      DateTime  @updatedAt

  idStock String
  stock   Stock  @relation(fields: [idStock], references: [id], onDelete: Cascade)

  /// Absent pour les lots repris de l'existant a la migration : ils n'ont pas
  /// de facture d'origine, et inventer un fournisseur serait mentir.
  idApprovisionnement String?
  approvisionnement   Approvisionnement? @relation(fields: [idApprovisionnement], references: [id])

  /// Sortie au plus proche de la peremption : cet index sert la regle.
  @@index([idStock, datePeremption])
  @@map("lots_stock")
}

model Facture {
  id                 String        @id @default(cuid())
  montantGnf         Int
  statut             InvoiceStatus @default(EN_ATTENTE)
  modePaiement       ModePaiement? // â† NOUVEAU : enum au lieu de String
  referenceOperateur String?       @unique
  numeroOperateur    String?
  urlRecu            String?
  payeeLe            DateTime?
  creeLe             DateTime      @default(now())
  modifieLe          DateTime      @updatedAt

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  idConsultation String?       @unique
  consultation   Consultation? @relation(fields: [idConsultation], references: [id])

  @@index([idPatient, creeLe(sort: Desc)])
  @@index([statut])
  @@map("factures")
}

/// Le texte d'un consentement, dans une version et une langue donnees
/// (EF-02-01).
///
/// **Un consentement ne vaut que pour ce qui a ete explique.** Sans garder le
/// texte exact qui etait a l'ecran, on ne peut ni prouver ce que la personne a
/// accepte, ni lui montrer plus tard ce a quoi elle a dit oui. Le texte evolue ;
/// les accords deja donnes continuent de pointer vers la version qu'ils ont vue.
///
/// **La langue fait partie du texte.** Un texte en francais montre a quelqu'un
/// qui lit le pular n'est pas un consentement eclaire. On enregistre donc la
/// langue reellement presentee, meme quand ce n'est pas celle du patient — la
/// trace dit alors la verite, et le manque se voit.
model TexteConsentement {
  id String @id @default(cuid())

  scope  ConsentScope
  langue String

  /// Numero de version, par portee et par langue. Commence a 1.
  version Int

  titre String
  /// Le texte presente, tel quel.
  corps String

  /// Mis en vigueur le... `null` tant que c'est un brouillon. Un brouillon ne
  /// peut etre montre a personne.
  publieLe    DateTime?
  idPubliePar String?
  publiePar   Utilisateur? @relation("TextesConsentementPublies", fields: [idPubliePar], references: [id], onDelete: SetNull)

  creeLe DateTime @default(now())

  consentements ConsentementPatient[]
  evenements    EvenementConsentement[]

  @@unique([scope, langue, version])
  @@index([scope, langue, publieLe])
  @@map("textes_consentement")
}

/// Ce qui est arrive au consentement d'une personne, en ajout seul (EF-02-07).
///
/// **« Versionne » veut dire qu'on garde l'histoire, pas seulement l'etat.**
/// Avant, un retrait ecrasait l'accord : on voyait que la personne refusait
/// aujourd'hui, jamais qu'elle avait accepte hier, ni combien de fois elle
/// avait change d'avis. Une table qui se laisse reecrire ne prouve rien le
/// jour ou il faudrait s'en servir, exactement comme le journal d'audit
/// (EF-12-04) : un declencheur PostgreSQL refuse ici aussi UPDATE, DELETE et
/// TRUNCATE.
model EvenementConsentement {
  id String @id @default(cuid())

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  scope ConsentScope
  sens  SensConsentement

  /// Le texte exact qui etait a l'ecran. `null` pour les accords poses avant
  /// EF-02-01, ou par le systeme : c'est precisement ce qu'il faut pouvoir
  /// distinguer d'un consentement reellement recueilli.
  idTexte String?
  texte   TexteConsentement? @relation(fields: [idTexte], references: [id], onDelete: Restrict)

  /// D'ou vient le geste : `WEB`, `MOBILE`, `COMPTOIR`, `DEFAUT_SYSTEME`...
  source      String
  commentaire String?

  /// Qui a enregistre le geste. Le patient lui-meme, le plus souvent.
  idAuteur String
  auteur   Utilisateur @relation("EvenementsConsentement", fields: [idAuteur], references: [id], onDelete: Restrict)

  creeLe DateTime @default(now())

  @@index([idPatient, creeLe])
  @@index([idPatient, scope, creeLe])
  @@map("evenements_consentement")
}

enum SensConsentement {
  ACCORDE
  RETIRE
}

model ConsentementPatient {
  id          String       @id @default(cuid())
  scope       ConsentScope
  actif       Boolean      @default(true)
  donneLe     DateTime     @default(now())
  retireLe    DateTime?
  source      String       @default("WEB")
  commentaire String?

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Cascade)

  idUtilisateur String
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [id], onDelete: Restrict)

  /// La version du texte que la personne avait sous les yeux (EF-02-01).
  ///
  /// `null` signifie **« accord presume, jamais recueilli »** : soit il a ete
  /// pose par le systeme a la creation du dossier, soit il est anterieur au
  /// versionnage. Ce n'est pas un detail d'implementation — c'est la
  /// difference entre un consentement et une case cochee a la place de
  /// quelqu'un, et l'ecran du patient le dit.
  idTexte String?
  texte   TexteConsentement? @relation(fields: [idTexte], references: [id], onDelete: Restrict)

  @@unique([idPatient, scope])
  @@index([scope, actif])
  @@map("consentements_patient")
}

model AlerteEpidemique {
  id            String                 @id @default(cuid())
  pathologie    String
  prefecture    String
  nombre        Int
  seuil         Int
  niveau        NiveauAlerteEpidemique
  fenetreJours  Int                    @default(30)
  statut        String                 @default("ACTIVE")
  dateDetection DateTime               @default(now())
  metadonnees   Json?

  @@unique([pathologie, prefecture, fenetreJours, statut])
  @@index([prefecture, statut])
  @@index([niveau, dateDetection])
  @@map("alertes_epidemiologiques")
}

model UssdSession {
  id        String            @id @default(cuid())
  telephone String
  etape     String            @default("ACCUEIL")
  statut    UssdSessionStatus @default(ACTIVE)
  donnees   Json?
  creeLe    DateTime          @default(now())
  expireLe  DateTime
  modifieLe DateTime          @updatedAt

  idUtilisateur String?
  utilisateur   Utilisateur? @relation(fields: [idUtilisateur], references: [id], onDelete: SetNull)

  @@index([telephone, statut])
  @@index([expireLe])
  @@map("ussd_sessions")
}

// Notification in-app : une ligne par destinataire, lue quand luLe est renseigne.
// Le SMS reste un canal a part (notification.service.ts) et n'est pas journalise ici.
model Notification {
  id          String           @id @default(cuid())
  type        TypeNotification
  titre       String
  contenu     String
  lienAction  String?
  metadonnees Json?
  luLe        DateTime?
  creeLe      DateTime         @default(now())

  idUtilisateur String
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [id], onDelete: Cascade)

  @@index([idUtilisateur, luLe])
  @@index([idUtilisateur, creeLe(sort: Desc)])
  @@map("notifications")
}

// Parametres globaux de la plateforme (espace super-admin). Une seule ligne,
// id = "global" ; les valeurs manquantes sont completees par les defauts du
// service (parametres.service.ts), ce qui permet d'ajouter un parametre sans
// migration.
model ParametresSysteme {
  id           String   @id @default("global")
  valeurs      Json
  modifieLe    DateTime @updatedAt
  idModifiePar String?

  @@map("parametres_systeme")
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// P1 â€” Hopital : episode de soins et demande d'analyse (EF-03)
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

// Numerotation lisible et continue (EP-2026-000123, DA-2026-000045...).
// Une ligne par cle ; l'increment se fait en SQL atomique (numero.service).
model Compteur {
  cle    String @id
  valeur Int    @default(0)

  @@map("compteurs")
}

model EpisodeSoins {
  id        String        @id @default(cuid())
  numero    String        @unique
  motif     String
  service   String?
  statut    StatutEpisode @default(OUVERT)
  notes     String?
  ouvertLe  DateTime      @default(now())
  closLe    DateTime?
  modifieLe DateTime      @updatedAt

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  idStructure String
  structure   StructureSante @relation(fields: [idStructure], references: [id])

  idOuvertPar String
  ouvertPar   Utilisateur @relation("EpisodeOuvertPar", fields: [idOuvertPar], references: [id], onDelete: Restrict)

  // Professionnel responsable de l'episode (medecin oriente)
  idResponsable String?
  responsable   Utilisateur? @relation("EpisodeResponsable", fields: [idResponsable], references: [id])

  demandesAnalyse DemandeAnalyse[]
  consultations   Consultation[]
  rendezVous      RendezVous[]

  /// La demande a distance qui a donne naissance a cet episode, s'il y en a
  /// une (addendum du 2026-09-28, point 6).
  demandeRendezVous DemandeRendezVous?

  @@index([idStructure, statut, ouvertLe(sort: Desc)])
  @@index([idPatient, ouvertLe(sort: Desc)])
  @@map("episodes_soins")
}

// Referentiel des examens de laboratoire, codes LOINC (EF-03-03, EF-13-04)
model Examen {
  id        String  @id @default(cuid())
  codeLoinc String  @unique
  libelle   String
  categorie String // HEMATOLOGIE, BIOCHIMIE, SEROLOGIE, PARASITOLOGIE, MICROBIOLOGIE, URINE...
  specimen  String // SANG, URINE, SELLES, ...
  unite     String?
  aJeun     Boolean @default(false)
  consignes String?
  prixGnf   Int?
  actif     Boolean @default(true)

  // Valeurs de reference (EF-04-04) et seuils critiques (EF-04-07), en unite
  // de l'examen. refTexte sert aux resultats qualitatifs (Negatif, Positif...).
  refMin      Float?
  refMax      Float?
  refTexte    String?
  critiqueMin Float?
  critiqueMax Float?

  lignes LigneDemandeAnalyse[]

  @@index([categorie, actif])
  @@map("examens")
}

model DemandeAnalyse {
  id                 String               @id @default(cuid())
  numero             String               @unique
  urgence            Urgence              @default(ROUTINE)
  statut             StatutDemandeAnalyse @default(TRANSMISE)
  indicationClinique String?
  consignesPatient   String?
  creeLe             DateTime             @default(now())
  transmiseLe        DateTime?
  modifieLe          DateTime             @updatedAt
  annuleeLe          DateTime?
  motifAnnulation    String?

  // Cycle laboratoire (EF-04)
  lieuPrelevement        LieuPrelevement?
  creneauPrelevement     DateTime?
  recueLe                DateTime?
  preleveeLe             DateTime?
  valideeLe              DateTime?
  /// Conclusion du laboratoire, ecrite par le laborantin qui valide.
  /// S'appelait `commentaireBiologiste` jusqu'au 2026-09-30 : le role de
  /// biologiste a ete supprime (addendum, point 4).
  commentaireLaboratoire String?
  /// Moment ou le patient a pu voir ses resultats. Depuis l'addendum du
  /// 2026-09-28, il n'est jamais pose par le temps qui passe : seul un medecin
  /// qui libere les resultats le renseigne. Avant, un resultat non critique
  /// partait des la validation du laboratoire, et un resultat critique finissait
  /// par partir seul au bout de 24 h â€” le patient lisait alors des termes que
  /// personne ne lui avait expliques.
  diffuseePatientLe      DateTime?
  /// Traduction en langage clair, redigee par le medecin au moment ou il libere
  /// les resultats. C'est elle qui donne son sens au chiffre.
  commentaireMedecin     String?
  /// Garde-fou : sans ces deux dates, un medecin absent laisserait un patient
  /// sans ses resultats indefiniment. On relance, puis on escalade vers
  /// l'administrateur de la structure â€” jamais vers le patient.
  relanceLiberationLe    DateTime?
  escaladeLiberationLe   DateTime?

  idValideur String?
  valideur   Utilisateur? @relation("Valideur", fields: [idValideur], references: [id])

  idLiberePar String?
  liberePar   Utilisateur? @relation("LibereParMedecin", fields: [idLiberePar], references: [id])

  echantillons     Echantillon[]
  alertesCritiques AlerteResultatCritique[]

  idEpisode String
  episode   EpisodeSoins @relation(fields: [idEpisode], references: [id], onDelete: Restrict)

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  idPrescripteur String
  prescripteur   Utilisateur @relation("Prescripteur", fields: [idPrescripteur], references: [id], onDelete: Restrict)

  idLaboratoire String
  laboratoire   StructureSante @relation("Laboratoire", fields: [idLaboratoire], references: [id])

  lignes LigneDemandeAnalyse[]

  @@index([idLaboratoire, statut, urgence, creeLe])
  @@index([idPatient, creeLe(sort: Desc)])
  @@index([idEpisode])
  /// File Â« a liberer Â» du medecin : ses demandes validees que le patient ne
  /// voit pas encore.
  @@index([idPrescripteur, statut, diffuseePatientLe])
  /// Job de relance et d'escalade : les validees que personne n'a liberees.
  @@index([statut, diffuseePatientLe, valideeLe])
  @@map("demandes_analyse")
}

model LigneDemandeAnalyse {
  id          String  @id @default(cuid())
  commentaire String?

  idDemande String
  demande   DemandeAnalyse @relation(fields: [idDemande], references: [id], onDelete: Cascade)

  idExamen String
  examen   Examen @relation(fields: [idExamen], references: [id])

  resultat ResultatAnalyse?

  @@unique([idDemande, idExamen])
  @@map("lignes_demande_analyse")
}

// Echantillon code sans ambiguite (EF-04-03) : EC-2026-000123
model Echantillon {
  id          String   @id @default(cuid())
  code        String   @unique
  specimen    String // SANG, URINE, SELLES, CRACHATS...
  preleveLe   DateTime @default(now())
  commentaire String?

  idDemande String
  demande   DemandeAnalyse @relation(fields: [idDemande], references: [id], onDelete: Cascade)

  idPreleveur String
  preleveur   Utilisateur @relation("Preleveur", fields: [idPreleveur], references: [id], onDelete: Restrict)

  resultats ResultatAnalyse[]

  @@index([idDemande])
  @@map("echantillons")
}

// Resultat d'une ligne de demande (EF-04-04) : valeur brute, lecture
// numerique quand elle existe, references figees au moment de la saisie.
model ResultatAnalyse {
  id              String                 @id @default(cuid())
  valeur          String
  valeurNumerique Float?
  unite           String?
  refMin          Float?
  refMax          Float?
  refTexte        String?
  interpretation  InterpretationResultat @default(NORMAL)
  commentaire     String?
  saisiLe         DateTime               @default(now())
  modifieLe       DateTime               @updatedAt

  idLigne String              @unique
  ligne   LigneDemandeAnalyse @relation(fields: [idLigne], references: [id], onDelete: Cascade)

  idEchantillon String?
  echantillon   Echantillon? @relation(fields: [idEchantillon], references: [id])

  idSaisiPar String
  saisiPar   Utilisateur @relation("SaisiPar", fields: [idSaisiPar], references: [id], onDelete: Restrict)

  alertes AlerteResultatCritique[]

  @@map("resultats_analyse")
}

// Alerte prioritaire au prescripteur pour un resultat critique, avec accuse
// de lecture et escalade automatique (EF-04-07, EF-04-08).
model AlerteResultatCritique {
  id          String    @id @default(cuid())
  creeLe      DateTime  @default(now())
  accuseeLe   DateTime?
  escaladeeLe DateTime?

  idDemande String
  demande   DemandeAnalyse @relation(fields: [idDemande], references: [id], onDelete: Cascade)

  idResultat String
  resultat   ResultatAnalyse @relation(fields: [idResultat], references: [id], onDelete: Cascade)

  idDestinataire String
  destinataire   Utilisateur @relation("DestinataireAlerte", fields: [idDestinataire], references: [id], onDelete: Restrict)

  idEscaladeVers String?
  escaladeVers   Utilisateur? @relation("EscaladeVers", fields: [idEscaladeVers], references: [id])

  @@index([idDestinataire, accuseeLe])
  @@index([accuseeLe, escaladeeLe, creeLe])
  @@map("alertes_resultat_critique")
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// P6 â€” Commande pharmacie (EF-07)
// Voir docs/PARCOURS-COMMANDE-LIVRAISON.md
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

enum StatutCommande {
  /// L'appel est lance, aucune pharmacie n'a encore declare tout avoir.
  RECHERCHE_PHARMACIE
  /// Une pharmacie a declare detenir la totalite : elle a la commande.
  PRISE_EN_CHARGE
  /// Aucune pharmacie du quartier ne detient la totalite, ou aucune n'est
  /// partenaire. Le patient repart avec son ordonnance.
  SANS_PHARMACIE
  ANNULEE
}

/// Mode de remise, choisi par le patient (decision du 2026-09-26). La
/// livraison n'est jamais imposee : beaucoup de patients habitent a cote d'une
/// pharmacie et iront chercher eux-memes.
enum ModeRemise {
  RETRAIT_PHARMACIE
  LIVRAISON
}

model Commande {
  id     String         @id @default(cuid())
  numero String         @unique // CM-2026-000123
  statut StatutCommande @default(RECHERCHE_PHARMACIE)

  /// Reste nul tant que le patient n'a pas choisi.
  modeRemise ModeRemise?

  /// Quartier vise par l'appel, fige a la creation : le patient peut
  /// demenager, la commande doit rester lisible telle qu'elle a ete passee.
  quartierRecherche String?

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  idOrdonnance String     @unique
  ordonnance   Ordonnance @relation(fields: [idOrdonnance], references: [id], onDelete: Cascade)

  /// La pharmacie qui a pris la commande. Nul tant que personne n'a declare
  /// detenir la totalite â€” c'est ce champ qui porte le verrou d'attribution.
  idPharmacie     String?
  pharmacie       StructureSante? @relation("PharmacieCommande", fields: [idPharmacie], references: [id])
  priseEnChargeLe DateTime?

  reponses ReponsePharmacie[]

  @@index([statut])
  @@index([idPharmacie])
  @@map("commandes")
}

/// Ce que chaque pharmacie sollicitee a repondu. On garde la trace meme des
/// reponses negatives : c'est ce qui permet de dire au patient Â« trois
/// pharmacies ont ete interrogees, aucune n'avait tout Â».
model ReponsePharmacie {
  id               String    @id @default(cuid())
  aTousLesProduits Boolean
  repondueLe       DateTime  @default(now())
  /// Renseigne quand une pharmacie se retracte apres avoir pris la commande.
  retracteeLe      DateTime?

  idCommande String
  commande   Commande @relation(fields: [idCommande], references: [id], onDelete: Cascade)

  idStructure String
  structure   StructureSante @relation("ReponsesPharmacie", fields: [idStructure], references: [id])

  @@unique([idCommande, idStructure])
  @@index([idCommande])
  @@map("reponses_pharmacie")
}

// ============================================================
// Vente au comptoir (addendum du 2026-09-28, points 1.1 et 1.2)
// ============================================================

/// Une vente au comptoir d'officine.
///
/// `Facture` ne pouvait pas la porter : elle n'a aucune ligne — donc on ne
/// sait pas ce qui a ete vendu, et il n'y a rien a totaliser dans un tableau
/// de bord — elle exige un `idPatient`, alors qu'un client de passage n'a pas
/// de dossier, et elle ne porte ni vendeur, ni remise, ni etablissement.
/// Elle reste donc la note d'une consultation, et la vente vit ici.
model VenteComptoir {
  id     String      @id @default(cuid())
  numero String      @unique
  statut StatutVente @default(PAYEE)

  /// Somme des lignes avant remise, la remise, et ce qui est reellement
  /// encaisse. Les trois sont stockes : recalculer le net a la lecture
  /// supposerait que la regle de remise n'a jamais change.
  montantBrutGnf Int
  remiseGnf      Int @default(0)
  montantNetGnf  Int

  modePaiement    ModePaiement
  numeroOperateur String?

  /// Facultatif : un passant n'a pas de dossier, et l'obliger a en ouvrir un
  /// pour acheter du savon n'a pas de sens. Renseigne, il relie la vente a
  /// l'historique du patient.
  idPatient String?
  patient   PatientProfile? @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  /// Facultative, sauf si la vente contient un produit reglemente ou d'une
  /// categorie que les parametres soumettent a ordonnance (EF-05-12).
  idOrdonnance String?
  ordonnance   Ordonnance? @relation(fields: [idOrdonnance], references: [id], onDelete: Restrict)

  idStructure String
  structure   StructureSante @relation(fields: [idStructure], references: [id], onDelete: Restrict)

  idVendeur String
  vendeur   Utilisateur @relation("VentesVendeur", fields: [idVendeur], references: [id], onDelete: Restrict)

  /// Tiers payant (EF-09). Sans contrat, l'assure paie tout : `montantAssureGnf`
  /// reste a 0 et `montantPatientGnf` egale le net.
  idContratAssurance String?
  contratAssurance   ContratAssurance? @relation(fields: [idContratAssurance], references: [id], onDelete: Restrict)

  /// Ce que l'assureur prend, et ce que le patient paie. Les deux sont
  /// stockes : recalculer la part de l'assureur a la lecture supposerait que
  /// ni les taux ni les exclusions n'ont change depuis.
  montantAssureGnf  Int @default(0)
  montantPatientGnf Int @default(0)

  annuleeLe       DateTime?
  motifAnnulation String?
  idAnnuleePar    String?
  annuleePar      Utilisateur? @relation("VentesAnnulees", fields: [idAnnuleePar], references: [id], onDelete: SetNull)

  creeLe DateTime @default(now())

  lignes LigneVente[]

  @@index([idStructure, creeLe(sort: Desc)])
  @@index([idStructure, statut])
  @@map("ventes_comptoir")
}

model LigneVente {
  id       String @id @default(cuid())
  quantite Int

  /// Prix figes au moment de la vente : prix national de reference plus la
  /// marge de l'officine. Les relire du catalogue plus tard donnerait un
  /// chiffre d'affaires qui change quand un tarif change.
  prixUnitaireGnf Int
  montantGnf      Int

  /// Les lots effectivement consommes, au format `[{ idLot, quantite }]`.
  /// Deux usages : annuler une erreur de saisie en remettant exactement ce qui
  /// est sorti, et savoir quel lot est parti chez qui en cas de rappel.
  lotsConsommes Json

  /// Le detail de la prise en charge, ligne par ligne (addendum, point 5.4).
  ///
  /// « Un reste a charge sans explication se conteste au comptoir » : le taux
  /// applique et, le cas echeant, le motif d'exclusion sont donc figes ici.
  couvert              Boolean @default(false)
  tauxAppliquePourcent Int     @default(0)
  montantAssureGnf     Int     @default(0)
  motifExclusion       String?

  idVente String
  vente   VenteComptoir @relation(fields: [idVente], references: [id], onDelete: Cascade)

  idMedicament String
  medicament   Medicament @relation(fields: [idMedicament], references: [id], onDelete: Restrict)

  @@index([idVente])
  @@index([idMedicament])
  @@map("lignes_vente")
}

// ============================================================
// Assurance et tiers payant (EF-09, addendum du 2026-09-28 point 5)
// ============================================================

/// Un assureur.
///
/// Rattache a une structure de type ASSURANCE quand il a des agents sur la
/// plateforme : ils se connectent alors comme tout le monde, avec les droits
/// de leur structure. Un assureur sans agents reste utilisable — ses contrats
/// sont saisis par l'administration.
model Assureur {
  id        String  @id @default(cuid())
  nom       String
  /// Code court, celui qui figure sur la carte de l'assure.
  code      String  @unique
  telephone String?
  email     String?
  estActif  Boolean @default(true)

  modeEchange ModeEchangeAssureur @default(MANUEL)

  idStructure String?         @unique
  structure   StructureSante? @relation(fields: [idStructure], references: [id], onDelete: SetNull)

  contrats ContratAssurance[]
  regles   RegleCouverture[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@map("assureurs")
}

/// Le contrat d'un patient chez un assureur.
model ContratAssurance {
  id           String @id @default(cuid())
  /// Le numero de police, tel qu'il figure sur la carte.
  numeroPolice String

  /// Taux de base, en pourcentage.
  ///
  /// **100 ne veut pas dire « tout est pris »** : il s'applique a ce qui est
  /// couvert, apres exclusions et dans la limite des plafonds. Un assure a
  /// 100 % paie quand meme son lait infantile.
  tauxBasePourcent Int @default(80)

  /// Plafond annuel de prise en charge, en GNF. 0 = pas de plafond.
  plafondAnnuelGnf Int @default(0)

  /// Franchise, en GNF : toujours a la charge du patient, deduite de la part
  /// de l'assureur.
  franchiseGnf Int @default(0)

  dateEffet DateTime
  dateFin   DateTime?

  /// Carence : jours apres la date d'effet pendant lesquels rien n'est pris.
  /// C'est ce qui empeche de s'assurer la veille d'une depense connue.
  carenceJours Int @default(0)

  statut StatutContrat @default(ACTIF)

  idAssureur String
  assureur   Assureur @relation(fields: [idAssureur], references: [id], onDelete: Restrict)

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  ventes    VenteComptoir[]
  controles ControleEligibilite[]

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  @@unique([idAssureur, numeroPolice])
  @@index([idPatient, statut])
  @@map("contrats_assurance")
}

/// Une regle de couverture par categorie de produit.
///
/// C'est ici que vivent les exclusions citees par le chef de projet : le lait
/// infantile, les cosmetiques. Elles visent `CategorieProduit`, une
/// enumeration fermee — on ne fonde pas une regle de remboursement sur un
/// champ que chacun remplit comme il veut.
///
/// `dateEffet` permet de changer un taux sans reecrire le passe : le calcul
/// retient la regle en vigueur a la date de la vente (EF-09-03).
model RegleCouverture {
  id        String           @id @default(cuid())
  categorie CategorieProduit

  /// Exclu : rien n'est pris, quel que soit le taux du contrat.
  exclu Boolean @default(false)

  /// Taux propre a cette categorie. Null : le taux de base du contrat.
  tauxPourcent Int?

  /// Plafond par ligne de vente, en GNF. 0 = pas de plafond.
  plafondLigneGnf Int @default(0)

  dateEffet DateTime @default(now())

  idAssureur String
  assureur   Assureur @relation(fields: [idAssureur], references: [id], onDelete: Cascade)

  creeLe DateTime @default(now())

  @@index([idAssureur, categorie, dateEffet])
  @@map("regles_couverture")
}

/// Un controle d'eligibilite au comptoir (addendum, point 5.1).
///
/// La reponse est **figee** : c'est elle qui sera opposable si l'assureur
/// contente la prise en charge plus tard. On ne la recalcule donc jamais, on
/// la relit.
model ControleEligibilite {
  id String @id @default(cuid())

  eligible Boolean
  /// Pourquoi la reponse est negative, en clair : c'est ce que le comptoir
  /// explique au patient.
  motif    String?

  /// Ce qui a ete lu au moment du controle, recopie pour que la reponse reste
  /// lisible meme si le contrat change ensuite.
  numeroPolice     String?
  tauxBasePourcent Int?

  idContrat String?
  contrat   ContratAssurance? @relation(fields: [idContrat], references: [id], onDelete: SetNull)

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  /// Ou le controle a eu lieu, et qui l'a fait.
  idStructure String
  structure   StructureSante @relation(fields: [idStructure], references: [id], onDelete: Restrict)

  idControlePar String
  controlePar   Utilisateur @relation("ControlesEligibilite", fields: [idControlePar], references: [id], onDelete: Restrict)

  creeLe DateTime @default(now())

  @@index([idPatient, creeLe(sort: Desc)])
  @@index([idStructure, creeLe(sort: Desc)])
  @@map("controles_eligibilite")
}
