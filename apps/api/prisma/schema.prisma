generator client {
  provider = "prisma-client"
  output   = "../src/config/generated/client"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────

enum Role {
  PATIENT
  ASC
  ASC_SUPERVISOR
  MEDECIN
  PHARMACIEN
  AGENT_ACCUEIL    // Hopital : admission, episodes de soins, demandes d'analyse (EF-03)
  TECHNICIEN_LABO  // Laboratoire : reception, prelevement, saisie des resultats (EF-04)
  BIOLOGISTE       // Laboratoire : idem + validation nominative des resultats (EF-04-05)
  ADMIN_STRUCTURE
  ADMIN_REGIONAL
  ADMIN_NATIONAL
  SUPER_ADMIN
}

enum EncounterStatus {
  PLANIFIEE
  EN_COURS
  TERMINEE
  ANNULEE
  REFERENCEE
}

enum ReferralStatus {
  EN_ATTENTE
  ACCEPTE
  REFUSE
  COMPLETE
}

enum InvoiceStatus {
  EN_ATTENTE
  PAYEE
  PARTIELLE
  ANNULEE
  REMBOURSEE
}

enum Urgence {
  ROUTINE
  URGENT
  URGENCE_VITALE
}

// Episode de soins : la visite d'un patient pour un motif precis (EF-03-02)
enum StatutEpisode {
  OUVERT
  EN_COURS
  CLOS
  ANNULE
}

// Demande d'analyse : de la transmission au laboratoire jusqu'aux resultats (EF-03-03, EF-04)
enum StatutDemandeAnalyse {
  TRANSMISE
  RECUE
  PRELEVEE
  EN_ANALYSE
  VALIDEE
  ANNULEE
}

// Prelevement sur place ou a domicile (EF-04-02)
enum LieuPrelevement {
  SUR_PLACE
  DOMICILE
}

// Lecture d'un resultat par rapport aux valeurs de reference et aux seuils
// critiques de l'examen (EF-04-04, EF-04-07)
enum InterpretationResultat {
  NORMAL
  ANORMAL
  CRITIQUE
}

enum TypeStructure {
  POSTE
  CENTRE
  HOPITAL_PREF
  HOPITAL_REG
  CHU
  CLINIQUE
  PHARMACIE        // ← NOUVEAU
  LABORATOIRE      // Laboratoire d'analyses (EF-04)
}

// Partage par l'ordonnance (le document) et par ses lignes. Une ligne ne prend
// que EN_ATTENTE ou DELIVREE ; le document ajoute PARTIELLEMENT_SERVIE et
// SERVIE, calcules a partir de ses lignes. DELIVREE reste dans le type pour les
// lignes : PostgreSQL ne permet pas de retirer une valeur d'enum sans recreer
// le type.
enum StatutOrdonnance {
  EN_ATTENTE
  DELIVREE
  PARTIELLEMENT_SERVIE
  SERVIE
  EXPIREE
  ANNULEE
}

enum ModePaiement {
  ESPECES
  ORANGE_MONEY
  MTN_MOMO
}

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

enum SyncMutationStatus {
  RECU
  TRAITE
  REJETE
}

enum ConsentScope {
  DOSSIER_MEDICAL
  FHIR_EXPORT
  RAPPELS_SMS
  RECHERCHE_ANONYMISEE
}

// Miroir de TypeNotification dans @baobaoheath/shared-types
enum TypeNotification {
  RAPPEL_RENDEZ_VOUS
  REFERENCEMENT_ACCEPTE
  REFERENCEMENT_REFUSE
  ALERTE_STOCK
  RAPPEL_VACCINATION
  ORDONNANCE_SIGNEE
  NOUVEAU_MESSAGE
  ALERTE_VITALE
  EPISODE_OUVERT
  DEMANDE_ANALYSE
  ORIENTATION
  PRELEVEMENT_PLANIFIE
  RESULTATS_DISPONIBLES
  RESULTAT_CRITIQUE
  ESCALADE_CRITIQUE
}

enum UssdSessionStatus {
  ACTIVE
  TERMINEE
  EXPIREE
}

enum NiveauAlerteEpidemique {
  ATTENTION
  ALERTE
  URGENCE
}

// ─── DOMAINE 1 — UTILISATEURS & ACCES ────────────────────

model Utilisateur {
  id                String    @id @default(cuid())
  telephone         String    @unique
  email             String?   @unique
  motDePasseHash    String
  role              Role
  prenom            String
  nom               String
  langue            String    @default("fr")
  photoUrl          String?
  estActif          Boolean   @default(true)
  twoFaActive       Boolean   @default(false)
  twoFaSecret       String?
  doitChangerMotDePasse Boolean @default(false)
  derniereConnexion DateTime?
  creeLe            DateTime  @default(now())
  modifieLe         DateTime  @updatedAt

  idStructure String?
  structure   StructureSante? @relation(fields: [idStructure], references: [id])

  patientProfile       PatientProfile?
  ascProfile           AscProfile?
  medecinProfile       MedecinProfile?
  pharmacienProfile    PharmacienProfile?
  sessions             Session[]
  authOtps             AuthOtp[]
  motDePasseResets     MotDePasseReset[]
  auditLogs            JournalAudit[]
  messagesEnvoyes      Message[]       @relation("Expediteur")
  messagesRecus        Message[]       @relation("Destinataire")
  consultationsSigne   Consultation[]  @relation("MedecinValideur")
  ordonnancesSigne     Ordonnance[]    @relation("MedecinSignataire")
  vaccinsAdministres   Vaccination[]
  referencementsValide Referencement[] @relation("MedecinValideurRef")
  episodesOuverts      EpisodeSoins[]  @relation("EpisodeOuvertPar")
  episodesResponsable  EpisodeSoins[]  @relation("EpisodeResponsable")
  demandesPrescrites   DemandeAnalyse[] @relation("Prescripteur")
  demandesValidees     DemandeAnalyse[] @relation("Valideur")
  echantillonsPreleves Echantillon[]    @relation("Preleveur")
  resultatsSaisis      ResultatAnalyse[] @relation("SaisiPar")
  alertesCritiques     AlerteResultatCritique[] @relation("DestinataireAlerte")
  alertesEscaladees    AlerteResultatCritique[] @relation("EscaladeVers")
  rendezVousMedecin    RendezVous[]    @relation("RendezVousMedecin")
  syncEvents            SyncEvent[]
  syncMutations         SyncMutation[]
  consentementsDonnes   ConsentementPatient[]
  ussdSessions          UssdSession[]
  notifications         Notification[]

  @@map("utilisateurs")
}

model Session {
  id           String   @id @default(cuid())
  refreshToken String   @unique
  expireLe     DateTime
  ipAdresse    String?
  userAgent    String?
  creeLe       DateTime @default(now())

  idUtilisateur String
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model AuthOtp {
  id            String    @id @default(cuid())
  codeHash      String
  expireLe      DateTime
  tentatives    Int       @default(0)
  maxTentatives Int       @default(5)
  utiliseLe     DateTime?
  creeLe        DateTime  @default(now())

  idUtilisateur String
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [id], onDelete: Cascade)

  @@index([idUtilisateur, expireLe])
  @@map("auth_otp")
}

model MotDePasseReset {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  expireLe   DateTime
  utiliseLe  DateTime?
  creeLe     DateTime  @default(now())

  idUtilisateur String
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [id], onDelete: Cascade)

  @@index([idUtilisateur])
  @@map("mot_de_passe_resets")
}

model JournalAudit {
  id          String   @id @default(cuid())
  action      String
  ressource   String
  idRessource String?
  ipAdresse   String?
  userAgent   String?
  metadonnees Json?
  creeLe      DateTime @default(now())

  idUtilisateur String
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [id], onDelete: Restrict)

  @@map("journal_audit")
}

model SyncEvent {
  id            String        @id @default(cuid())
  version       Int           @unique @default(autoincrement())
  scope         String
  entityType    String
  entityId      String?
  operation     SyncOperation
  payload       Json?
  idStructure   String?
  idUtilisateur String?
  creeLe        DateTime      @default(now())

  utilisateur Utilisateur? @relation(fields: [idUtilisateur], references: [id], onDelete: SetNull)

  @@index([scope, version])
  @@index([idStructure, version])
  @@index([idUtilisateur, version])
  @@map("sync_events")
}

model SyncMutation {
  id               String             @id @default(cuid())
  clientMutationId String             @unique
  deviceId         String?
  entityType       String
  entityId         String?
  operation        SyncOperation
  payload          Json
  baseVersion      Int?
  statut           SyncMutationStatus @default(RECU)
  erreur           String?
  creeLe           DateTime           @default(now())
  traiteLe         DateTime?

  idUtilisateur String
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [id], onDelete: Cascade)

  @@index([idUtilisateur, creeLe])
  @@index([statut, creeLe])
  @@map("sync_mutations")
}

// ─── DOMAINE 2 — ACTEURS DE SANTE ────────────────────────

model StructureSante {
  id          String        @id @default(cuid())
  nom         String
  type        TypeStructure
  prefecture  String
  adresse     String?
  latitude    Float?
  longitude   Float?
  telephone   String?
  photoUrl    String?
  estActive   Boolean       @default(true)
  creeLe      DateTime      @default(now())

  utilisateurs            Utilisateur[]
  ascProfiles             AscProfile[]
  medecinProfiles         MedecinProfile[]
  pharmacienProfiles      PharmacienProfile[]
  stocks                  Stock[]
  patientsPreferent       PatientProfile[]    @relation("StructurePreferee")
  referencementsSource    Referencement[]     @relation("StructureSource")
  referencementsCible     Referencement[]     @relation("StructureCible")
  episodes                EpisodeSoins[]
  demandesAnalyseRecues   DemandeAnalyse[]    @relation("Laboratoire")

  @@map("structures")
}

model PatientProfile {
  id                 String   @id @default(cuid())
  qrCode             String   @unique @default(cuid())
  dateNaissance      DateTime
  sexe               String
  groupeSanguin      String?
  allergies          String[]
  maladiesChroniques String[]
  prefecture         String
  sousPrefecture     String?
  village            String?
  latitude           Float?
  longitude          Float?
  photoUrl           String?
  urgenceNom         String?
  urgenceTelephone   String?
  creeLe             DateTime @default(now())
  modifieLe          DateTime @updatedAt

  idUtilisateur String      @unique
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [id], onDelete: Restrict)

  // ── MODELE HYBRIDE ────────────────────────────────────────
  // Structure préférée choisie par le patient (optionnel)
  idStructurePreferee String?
  structurePreferee   StructureSante? @relation("StructurePreferee", fields: [idStructurePreferee], references: [id])

  // ASC attitré du patient (optionnel)
  idAscPrincipal String?
  ascPrincipal   AscProfile? @relation("PatientAscPrincipal", fields: [idAscPrincipal], references: [id])

  consultations Consultation[]
  vaccinations  Vaccination[]
  factures      Facture[]
  rendezVous    RendezVous[]
  consentements ConsentementPatient[]
  episodes      EpisodeSoins[]
  demandesAnalyse DemandeAnalyse[]

  @@index([prefecture])
  @@index([idStructurePreferee])
  @@index([idAscPrincipal])
  @@map("patients")
}

model AscProfile {
  id                  String   @id @default(cuid())
  zoneCouverture      Json?
  numeroCertification String?
  photoUrl            String?
  creeLe              DateTime @default(now())

  idUtilisateur String      @unique
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [id], onDelete: Restrict)

  idSuperviseur String?
  superviseur   AscProfile?  @relation("Supervision", fields: [idSuperviseur], references: [id])
  supervises    AscProfile[] @relation("Supervision")

  idStructure String?
  structure   StructureSante? @relation(fields: [idStructure], references: [id])

  consultations  Consultation[]
  stocks         Stock[]
  rendezVous     RendezVous[]
  patientsAttitres PatientProfile[] @relation("PatientAscPrincipal")

  @@map("profils_asc")
}

model MedecinProfile {
  id          String   @id @default(cuid())
  numeroCom   String?
  specialite  String?
  photoUrl    String?
  creeLe      DateTime @default(now())

  idUtilisateur String         @unique
  utilisateur   Utilisateur    @relation(fields: [idUtilisateur], references: [id], onDelete: Restrict)

  idStructure String?
  structure   StructureSante? @relation(fields: [idStructure], references: [id])

  @@map("profils_medecin")
}

// ── NOUVEAU : PharmacienProfile ───────────────────────────
model PharmacienProfile {
  id             String   @id @default(cuid())
  photoUrl       String?
  estResponsable Boolean  @default(false)
  creeLe         DateTime @default(now())

  idUtilisateur String      @unique
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [id], onDelete: Restrict)

  idStructure String?
  structure   StructureSante? @relation(fields: [idStructure], references: [id])

  @@map("profils_pharmacien")
}

// ─── DOMAINE 3 — ACTES MEDICAUX ──────────────────────────

model Consultation {
  id               String          @id @default(cuid())
  statut           EncounterStatus @default(EN_COURS)
  motifPrincipal   String
  symptomes        String[]
  protocoleUtilise String?
  confianceIa      Float?
  resumeIa         String?
  notesAsc         String?
  notesMedecin     String?
  piecesJointes    String[]
  signeLe          DateTime?
  tarifGnf         Int?
  consulteeLE      DateTime        @default(now())
  creeLe           DateTime        @default(now())
  modifieLe        DateTime        @updatedAt

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  idAsc String?
  asc   AscProfile? @relation(fields: [idAsc], references: [id])

  idMedecinValideur String?
  medecinValideur   Utilisateur? @relation("MedecinValideur", fields: [idMedecinValideur], references: [id])

  idEpisode String?
  episode   EpisodeSoins? @relation(fields: [idEpisode], references: [id])

  constantes    ConstantesVitales?
  diagnostics   Diagnostic[]
  ordonnances   Ordonnance[]
  referencement Referencement?
  facture       Facture?
  rendezVous    RendezVous?
  messages      Message[]

  @@index([idPatient, consulteeLE(sort: Desc)])
  @@index([idAsc])
  @@index([idMedecinValideur])
  @@index([idEpisode])
  @@index([statut])
  @@map("consultations")
}

model ConstantesVitales {
  id                    String   @id @default(cuid())
  temperature           Float?
  poidsKg               Float?
  tailleCm              Float?
  perimetreBrachial     Float?
  tensionSystolique     Int?
  tensionDiastolique    Int?
  frequenceCardiaque    Int?
  frequenceRespiratoire Int?
  spo2                  Float?
  glycemie              Float?
  alertes               String[]
  mesureLe              DateTime @default(now())

  idConsultation String       @unique
  consultation   Consultation @relation(fields: [idConsultation], references: [id], onDelete: Cascade)

  @@map("constantes_vitales")
}

model Diagnostic {
  id             String   @id @default(cuid())
  libelle        String
  codeIcd11      String?
  typeDiagnostic String   @default("PRINCIPAL")
  severite       String?
  statutClinique String   @default("ACTIF")
  source         String
  creeLe         DateTime @default(now())

  idConsultation String
  consultation   Consultation @relation(fields: [idConsultation], references: [id], onDelete: Cascade)

  @@index([idConsultation])
  @@index([creeLe, libelle])
  @@map("diagnostics")
}

model Medicament {
  id               String   @id @default(cuid())
  dci              String
  nomCommercial    String?
  forme            String
  dosage           String
  categorie        String?
  imageUrl         String?
  listeEssentielle Boolean  @default(false)
  estActif         Boolean  @default(true)
  prixUnitaireGnf  Int      @default(0) // prix national de référence en GNF

  // Classification ATC (EF-05-05, decision D6). Elle permet de rapprocher deux
  // specialites de la meme famille : un patient allergique a l'amoxicilline
  // l'est a toute la classe J01C, que la comparaison sur la DCI seule
  // manquerait.
  codeAtc String?

  /// Contre-indications connues, en texte libre tant que le referentiel
  /// national (D6) n'est pas arrete. Comparees aux maladies chroniques du
  /// patient (EF-05-06).
  contreIndications String[]

  lignesOrdonnance LigneOrdonnance[]
  stocks           Stock[]

  @@index([codeAtc])
  @@map("medicaments")
}

// Gravite d'une interaction, du plus leger au plus grave. L'ordre des valeurs
// fait foi : le service compare par rang pour decider ce qui merite un motif
// de depassement.
enum NiveauInteraction {
  PRECAUTION
  ASSOCIATION_DECONSEILLEE
  CONTRE_INDICATION
}

/// Interaction connue entre deux principes actifs (EF-05-05).
///
/// Une interaction est symetrique : le couple est toujours stocke ordonne
/// (dciA < dciB, en minuscules) pour qu'une meme paire ne puisse pas exister
/// deux fois dans les deux sens.
model InteractionMedicament {
  id          String            @id @default(cuid())
  dciA        String
  dciB        String
  niveau      NiveauInteraction
  description String
  /// Conduite a tenir, affichee au prescripteur avec l'alerte.
  conduite String?
  /// Referentiel d'origine, pour pouvoir reexaminer une regle contestee.
  source String?
  creeLe DateTime @default(now())

  @@unique([dciA, dciB])
  @@index([dciA])
  @@index([dciB])
  @@map("interactions_medicaments")
}

// L'ordonnance est un *document* : un numero unique, un code de verification
// remis au patient, une date de fin de validite. C'est lui que la pharmacie
// controle avant de delivrer quoi que ce soit (EF-05-07/08, EF-07-01). Les
// medicaments prescrits sont ses lignes.
model Ordonnance {
  id     String           @id @default(cuid())
  numero String           @unique // OR-2026-000123
  statut StatutOrdonnance @default(EN_ATTENTE)

  // Court, sans caracteres ambigus, lu a voix haute ou recopie depuis le
  // papier. Il ne remplace pas le numero : il prouve que le porteur a bien
  // l'ordonnance en main, le numero seul etant devinable.
  codeVerification String

  // Au-dela, la pharmacie refuse. La duree par defaut est un parametre
  // systeme, jamais une constante (decision D2 du cahier des charges).
  valideJusquau DateTime

  urlDocument String?
  creeLe      DateTime @default(now())
  modifieLe   DateTime @updatedAt

  idConsultation String
  consultation   Consultation @relation(fields: [idConsultation], references: [id], onDelete: Cascade)

  // Signature nominative du prescripteur : sans elle, l'ordonnance n'est pas
  // opposable et la pharmacie doit la refuser.
  signePar   String?
  signataire Utilisateur? @relation("MedecinSignataire", fields: [signePar], references: [id])
  signeLe    DateTime?

  lignes LigneOrdonnance[]

  @@index([idConsultation])
  @@index([statut])
  @@index([valideJusquau])
  @@map("ordonnances")
}

// Un medicament prescrit. La delivrance se fait ligne par ligne : une
// pharmacie peut n'avoir qu'une partie du traitement (delivrance partielle,
// EF-07-07), et le statut du document se deduit de ses lignes.
model LigneOrdonnance {
  id           String           @id @default(cuid())
  posologie    String
  frequence    String
  dureeJours   Int
  quantite     Int              @default(1)
  instructions String?
  statut       StatutOrdonnance @default(EN_ATTENTE)
  creeLe       DateTime         @default(now())

  // EF-05-06 : les alertes presentees au prescripteur au moment de la
  // prescription, figees telles quelles. Le referentiel evoluera ; ce qui
  // compte est ce qui lui a ete montre ce jour-la.
  alertes Json?

  /// Pourquoi le prescripteur a passe outre. Nul quand aucune alerte n'a
  /// ete declenchee, ou quand il n'a pas motive son choix.
  motifDepassement String?

  idOrdonnance String
  ordonnance   Ordonnance @relation(fields: [idOrdonnance], references: [id], onDelete: Cascade)

  idMedicament String
  medicament   Medicament @relation(fields: [idMedicament], references: [id])

  @@index([idOrdonnance])
  @@index([statut])
  @@map("lignes_ordonnance")
}

model Vaccination {
  id              String    @id @default(cuid())
  vaccinNom       String
  codeEpi         String?
  numeroLot       String?
  siteInjection   String?
  reaction        String?
  urlCertificat   String?
  dateProchaineD  DateTime?
  administreLe    DateTime  @default(now())

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  idAdministrePar String
  administrePar   Utilisateur @relation(fields: [idAdministrePar], references: [id])

  @@index([idPatient, administreLe(sort: Desc)])
  @@index([dateProchaineD])
  @@map("vaccinations")
}

// ─── DOMAINE 4 — COORDINATION ────────────────────────────

model RendezVous {
  id        String   @id @default(cuid())
  statut    String   @default("PLANIFIE")
  motif     String?
  prevuLe   DateTime
  rappel24h Boolean  @default(false)
  rappel2h  Boolean  @default(false)
  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  idAsc String?
  asc   AscProfile? @relation(fields: [idAsc], references: [id])

  // Orientation vers un medecin depuis l'accueil (EF-03-05)
  idMedecin String?
  medecin   Utilisateur? @relation("RendezVousMedecin", fields: [idMedecin], references: [id])

  idEpisode String?
  episode   EpisodeSoins? @relation(fields: [idEpisode], references: [id])

  idConsultation String?       @unique
  consultation   Consultation? @relation(fields: [idConsultation], references: [id])

  @@index([idPatient])
  @@index([idAsc])
  @@index([idMedecin, prevuLe])
  @@index([idEpisode])
  @@index([prevuLe, statut, rappel24h])
  @@map("rendez_vous")
}

model Referencement {
  id             String         @id @default(cuid())
  urgence        Urgence        @default(ROUTINE)
  statut         ReferralStatus @default(EN_ATTENTE)
  resumeClinique String
  motifRefus     String?
  urlDocument    String?
  creeLe         DateTime       @default(now())
  reponduLe      DateTime?

  idConsultation String       @unique
  consultation   Consultation @relation(fields: [idConsultation], references: [id], onDelete: Cascade)

  idStructureSource String?
  structureSource   StructureSante? @relation("StructureSource", fields: [idStructureSource], references: [id])

  idStructureCible String
  structureCible   StructureSante @relation("StructureCible", fields: [idStructureCible], references: [id])

  idMedecinValideur String?
  medecinValideur   Utilisateur? @relation("MedecinValideurRef", fields: [idMedecinValideur], references: [id])

  @@index([idStructureCible, statut])
  @@index([creeLe])
  @@map("referencements")
}

model Message {
  id       String    @id @default(cuid())
  contenu  String
  lu       Boolean   @default(false)
  luLe     DateTime?
  envoyeLe DateTime  @default(now())

  idExpediteur String
  expediteur   Utilisateur @relation("Expediteur", fields: [idExpediteur], references: [id], onDelete: Restrict)

  idDestinataire String
  destinataire   Utilisateur @relation("Destinataire", fields: [idDestinataire], references: [id], onDelete: Restrict)

  idConsultation String?
  consultation   Consultation? @relation(fields: [idConsultation], references: [id])

  @@index([idDestinataire, lu])
  @@index([idExpediteur])
  @@map("messages")
}

// ─── DOMAINE 5 — GESTION OPERATIONNELLE ──────────────────

model Stock {
  id              String    @id @default(cuid())
  quantite        Int       @default(0)
  seuilAlerte     Int       @default(10)
  unite           String
  datePeremption  DateTime?
  margeGnf        Int       @default(0) // ← NOUVEAU : marge appliquée par la pharmacie
  modifieLe       DateTime  @updatedAt

  idAsc String?
  asc   AscProfile? @relation(fields: [idAsc], references: [id], onDelete: Restrict)

  idStructure String?
  structure   StructureSante? @relation(fields: [idStructure], references: [id], onDelete: Restrict)

  idMedicament String
  medicament   Medicament @relation(fields: [idMedicament], references: [id])

  @@unique([idAsc, idMedicament])
  @@unique([idStructure, idMedicament])
  @@map("stocks")
}

model Facture {
  id                 String        @id @default(cuid())
  montantGnf         Int
  statut             InvoiceStatus @default(EN_ATTENTE)
  modePaiement       ModePaiement? // ← NOUVEAU : enum au lieu de String
  referenceOperateur String?       @unique
  numeroOperateur    String?
  urlRecu            String?
  payeeLe            DateTime?
  creeLe             DateTime      @default(now())
  modifieLe          DateTime      @updatedAt

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  idConsultation String?       @unique
  consultation   Consultation? @relation(fields: [idConsultation], references: [id])

  @@index([idPatient, creeLe(sort: Desc)])
  @@index([statut])
  @@map("factures")
}

model ConsentementPatient {
  id            String       @id @default(cuid())
  scope         ConsentScope
  actif         Boolean      @default(true)
  donneLe       DateTime     @default(now())
  retireLe      DateTime?
  source        String       @default("WEB")
  commentaire   String?

  idPatient     String
  patient       PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Cascade)

  idUtilisateur String
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [id], onDelete: Restrict)

  @@unique([idPatient, scope])
  @@index([scope, actif])
  @@map("consentements_patient")
}

model AlerteEpidemique {
  id            String                  @id @default(cuid())
  pathologie    String
  prefecture    String
  nombre        Int
  seuil         Int
  niveau        NiveauAlerteEpidemique
  fenetreJours  Int                     @default(30)
  statut        String                  @default("ACTIVE")
  dateDetection DateTime                @default(now())
  metadonnees   Json?

  @@unique([pathologie, prefecture, fenetreJours, statut])
  @@index([prefecture, statut])
  @@index([niveau, dateDetection])
  @@map("alertes_epidemiologiques")
}

model UssdSession {
  id          String            @id @default(cuid())
  telephone   String
  etape       String            @default("ACCUEIL")
  statut      UssdSessionStatus @default(ACTIVE)
  donnees     Json?
  creeLe      DateTime          @default(now())
  expireLe    DateTime
  modifieLe   DateTime          @updatedAt

  idUtilisateur String?
  utilisateur   Utilisateur? @relation(fields: [idUtilisateur], references: [id], onDelete: SetNull)

  @@index([telephone, statut])
  @@index([expireLe])
  @@map("ussd_sessions")
}

// Notification in-app : une ligne par destinataire, lue quand luLe est renseigne.
// Le SMS reste un canal a part (notification.service.ts) et n'est pas journalise ici.
model Notification {
  id          String           @id @default(cuid())
  type        TypeNotification
  titre       String
  contenu     String
  lienAction  String?
  metadonnees Json?
  luLe        DateTime?
  creeLe      DateTime         @default(now())

  idUtilisateur String
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [id], onDelete: Cascade)

  @@index([idUtilisateur, luLe])
  @@index([idUtilisateur, creeLe(sort: Desc)])
  @@map("notifications")
}

// Parametres globaux de la plateforme (espace super-admin). Une seule ligne,
// id = "global" ; les valeurs manquantes sont completees par les defauts du
// service (parametres.service.ts), ce qui permet d'ajouter un parametre sans
// migration.
model ParametresSysteme {
  id           String   @id @default("global")
  valeurs      Json
  modifieLe    DateTime @updatedAt
  idModifiePar String?

  @@map("parametres_systeme")
}

// ═══════════════════════════════════════════════════════════════════
// P1 — Hopital : episode de soins et demande d'analyse (EF-03)
// ═══════════════════════════════════════════════════════════════════

// Numerotation lisible et continue (EP-2026-000123, DA-2026-000045...).
// Une ligne par cle ; l'increment se fait en SQL atomique (numero.service).
model Compteur {
  cle    String @id
  valeur Int    @default(0)

  @@map("compteurs")
}

model EpisodeSoins {
  id       String        @id @default(cuid())
  numero   String        @unique
  motif    String
  service  String?
  statut   StatutEpisode @default(OUVERT)
  notes    String?
  ouvertLe DateTime      @default(now())
  closLe   DateTime?
  modifieLe DateTime     @updatedAt

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  idStructure String
  structure   StructureSante @relation(fields: [idStructure], references: [id])

  idOuvertPar String
  ouvertPar   Utilisateur @relation("EpisodeOuvertPar", fields: [idOuvertPar], references: [id], onDelete: Restrict)

  // Professionnel responsable de l'episode (medecin oriente)
  idResponsable String?
  responsable   Utilisateur? @relation("EpisodeResponsable", fields: [idResponsable], references: [id])

  demandesAnalyse DemandeAnalyse[]
  consultations   Consultation[]
  rendezVous      RendezVous[]

  @@index([idStructure, statut, ouvertLe(sort: Desc)])
  @@index([idPatient, ouvertLe(sort: Desc)])
  @@map("episodes_soins")
}

// Referentiel des examens de laboratoire, codes LOINC (EF-03-03, EF-13-04)
model Examen {
  id        String  @id @default(cuid())
  codeLoinc String  @unique
  libelle   String
  categorie String  // HEMATOLOGIE, BIOCHIMIE, SEROLOGIE, PARASITOLOGIE, MICROBIOLOGIE, URINE...
  specimen  String  // SANG, URINE, SELLES, ...
  unite     String?
  aJeun     Boolean @default(false)
  consignes String?
  prixGnf   Int?
  actif     Boolean @default(true)

  // Valeurs de reference (EF-04-04) et seuils critiques (EF-04-07), en unite
  // de l'examen. refTexte sert aux resultats qualitatifs (Negatif, Positif...).
  refMin      Float?
  refMax      Float?
  refTexte    String?
  critiqueMin Float?
  critiqueMax Float?

  lignes LigneDemandeAnalyse[]

  @@index([categorie, actif])
  @@map("examens")
}

model DemandeAnalyse {
  id                 String               @id @default(cuid())
  numero             String               @unique
  urgence            Urgence              @default(ROUTINE)
  statut             StatutDemandeAnalyse @default(TRANSMISE)
  indicationClinique String?
  consignesPatient   String?
  creeLe             DateTime             @default(now())
  transmiseLe        DateTime?
  modifieLe          DateTime             @updatedAt
  annuleeLe          DateTime?
  motifAnnulation    String?

  // Cycle laboratoire (EF-04)
  lieuPrelevement       LieuPrelevement?
  creneauPrelevement    DateTime?
  recueLe               DateTime?
  preleveeLe            DateTime?
  valideeLe             DateTime?
  commentaireBiologiste String?
  // Diffusion au patient : immediate apres validation, differee si un
  // resultat critique attend l'accuse de lecture du prescripteur (EF-04-09).
  diffuseePatientLe     DateTime?

  idValideur String?
  valideur   Utilisateur? @relation("Valideur", fields: [idValideur], references: [id])

  echantillons     Echantillon[]
  alertesCritiques AlerteResultatCritique[]

  idEpisode String
  episode   EpisodeSoins @relation(fields: [idEpisode], references: [id], onDelete: Restrict)

  idPatient String
  patient   PatientProfile @relation(fields: [idPatient], references: [id], onDelete: Restrict)

  idPrescripteur String
  prescripteur   Utilisateur @relation("Prescripteur", fields: [idPrescripteur], references: [id], onDelete: Restrict)

  idLaboratoire String
  laboratoire   StructureSante @relation("Laboratoire", fields: [idLaboratoire], references: [id])

  lignes LigneDemandeAnalyse[]

  @@index([idLaboratoire, statut, urgence, creeLe])
  @@index([idPatient, creeLe(sort: Desc)])
  @@index([idEpisode])
  @@map("demandes_analyse")
}

model LigneDemandeAnalyse {
  id          String  @id @default(cuid())
  commentaire String?

  idDemande String
  demande   DemandeAnalyse @relation(fields: [idDemande], references: [id], onDelete: Cascade)

  idExamen String
  examen   Examen @relation(fields: [idExamen], references: [id])

  resultat ResultatAnalyse?

  @@unique([idDemande, idExamen])
  @@map("lignes_demande_analyse")
}

// Echantillon code sans ambiguite (EF-04-03) : EC-2026-000123
model Echantillon {
  id          String    @id @default(cuid())
  code        String    @unique
  specimen    String    // SANG, URINE, SELLES, CRACHATS...
  preleveLe   DateTime  @default(now())
  commentaire String?

  idDemande String
  demande   DemandeAnalyse @relation(fields: [idDemande], references: [id], onDelete: Cascade)

  idPreleveur String
  preleveur   Utilisateur @relation("Preleveur", fields: [idPreleveur], references: [id], onDelete: Restrict)

  resultats ResultatAnalyse[]

  @@index([idDemande])
  @@map("echantillons")
}

// Resultat d'une ligne de demande (EF-04-04) : valeur brute, lecture
// numerique quand elle existe, references figees au moment de la saisie.
model ResultatAnalyse {
  id              String                 @id @default(cuid())
  valeur          String
  valeurNumerique Float?
  unite           String?
  refMin          Float?
  refMax          Float?
  refTexte        String?
  interpretation  InterpretationResultat @default(NORMAL)
  commentaire     String?
  saisiLe         DateTime               @default(now())
  modifieLe       DateTime               @updatedAt

  idLigne String              @unique
  ligne   LigneDemandeAnalyse @relation(fields: [idLigne], references: [id], onDelete: Cascade)

  idEchantillon String?
  echantillon   Echantillon? @relation(fields: [idEchantillon], references: [id])

  idSaisiPar String
  saisiPar   Utilisateur @relation("SaisiPar", fields: [idSaisiPar], references: [id], onDelete: Restrict)

  alertes AlerteResultatCritique[]

  @@map("resultats_analyse")
}

// Alerte prioritaire au prescripteur pour un resultat critique, avec accuse
// de lecture et escalade automatique (EF-04-07, EF-04-08).
model AlerteResultatCritique {
  id          String    @id @default(cuid())
  creeLe      DateTime  @default(now())
  accuseeLe   DateTime?
  escaladeeLe DateTime?

  idDemande String
  demande   DemandeAnalyse @relation(fields: [idDemande], references: [id], onDelete: Cascade)

  idResultat String
  resultat   ResultatAnalyse @relation(fields: [idResultat], references: [id], onDelete: Cascade)

  idDestinataire String
  destinataire   Utilisateur @relation("DestinataireAlerte", fields: [idDestinataire], references: [id], onDelete: Restrict)

  idEscaladeVers String?
  escaladeVers   Utilisateur? @relation("EscaladeVers", fields: [idEscaladeVers], references: [id])

  @@index([idDestinataire, accuseeLe])
  @@index([accuseeLe, escaladeeLe, creeLe])
  @@map("alertes_resultat_critique")
}
