model StructureSante {
  id         String        @id @default(cuid())
  nom        String
  type       TypeStructure
  prefecture String
  commune    String?
  quartier   String?
  adresse    String?

  /// Partenaire conventionne : seules ces structures sont sollicitees pour une
  /// commande (EF-12-02). La gestion complete des conventions viendra avec
  /// P11 ; ici on ne retient que ce qu'il faut pour savoir qui notifier.
  estPartenaire    Boolean   @default(false)
  partenaireDepuis DateTime?

  commandes            Commande[]            @relation("PharmacieCommande")
  reponsesCommandes    ReponsePharmacie[]    @relation("ReponsesPharmacie")
  ventesComptoir       VenteComptoir[]
  assureur             Assureur?
  controlesEligibilite ControleEligibilite[]
  latitude             Float?
  longitude            Float?
  telephone            String?
  photoUrl             String?
  estActive            Boolean               @default(true)
  creeLe               DateTime              @default(now())

  utilisateurs          Utilisateur[]
  ascProfiles           AscProfile[]
  medecinProfiles       MedecinProfile[]
  pharmacienProfiles    PharmacienProfile[]
  stocks                Stock[]
  patientsPreferent     PatientProfile[]    @relation("StructurePreferee")
  demandesRendezVous    DemandeRendezVous[] @relation("DemandesRendezVous")
  approvisionnements    Approvisionnement[] @relation("ApprovisionnementsStructure")
  referencementsSource  Referencement[]     @relation("StructureSource")
  referencementsCible   Referencement[]     @relation("StructureCible")
  episodes              EpisodeSoins[]
  demandesAnalyseRecues DemandeAnalyse[]    @relation("Laboratoire")

  @@map("structures")
}

/// Le degre de confiance dans l'identite d'un patient (EF-01-04).
///
/// **Ce que ces niveaux ne font pas : trier qui a droit aux soins.** Un
/// patient a l'identite provisoire se fait consulter, suivre et prescrire
/// normalement. Le niveau ne verrouille que ce qui engage un tiers — la
/// facturation a un assureur et la delivrance de produits reglementes — parce
/// que la, une erreur d'identite coute a quelqu'un d'autre.
enum NiveauIdentite {
  /// Identite declaree, aucun document presente. C'est l'etat par defaut :
  /// un ASC qui enregistre quelqu'un en brousse n'a pas de piece a verifier,
  /// et le refuser reviendrait a lui refuser les soins.
  PROVISOIRE
  /// Un agent habilite a vu une piece et a enregistre laquelle.
  VERIFIEE
}

/// La piece presentee lors de la verification (EF-01-04).
enum TypePieceIdentite {
  CARTE_NATIONALE
  PASSEPORT
  /// Frequent pour les mineurs, qui n'ont pas de carte.
  ACTE_NAISSANCE
  CARTE_CONSULAIRE
  PERMIS_CONDUIRE
  /// Carte d'electeur, carte scolaire, attestation : l'agent precise laquelle.
  AUTRE
}

model PatientProfile {
  id                 String   @id @default(cuid())
  qrCode             String   @unique @default(cuid())
  dateNaissance      DateTime
  sexe               String
  groupeSanguin      String?
  allergies          String[]
  maladiesChroniques String[]
  prefecture         String
  sousPrefecture     String?

  // ── Identito-vigilance (EF-01-04/10) ──────────────────────────────
  //
  // Les traits qui distinguent deux personnes quand le nom ne suffit pas —
  // et il ne suffit pas souvent. Dans la region, les homonymes sont la regle
  // plutot que l'exception : « Mamadou Diallo, ne en 1990 » peut designer
  // plusieurs personnes dans la meme prefecture. Le lieu de naissance et le
  // nom de la mere sont les deux traits qui tranchent, et ce sont ceux
  // qu'emploient les registres de l'etat civil.
  //
  // Facultatifs : un ASC qui enregistre quelqu'un en brousse ne les a pas
  // toujours. Ils deviennent exigibles pour passer en identite verifiee.
  /// Ville ou village de naissance, tel que declare.
  lieuNaissance String?
  /// Nom de la mere. Le trait le plus discriminant quand les noms se repetent.
  nomMere       String?

  /// Le degre de confiance dans cette identite. Voir `NiveauIdentite`.
  niveauIdentite NiveauIdentite @default(PROVISOIRE)

  /// La piece presentee, quand l'identite a ete verifiee.
  typePiece   TypePieceIdentite?
  /// Le numero de la piece. Jamais affiche en entier a l'ecran.
  numeroPiece String?

  /// Quand et par qui. Une verification sans auteur ne vaut rien : c'est
  /// l'agent qui engage sa responsabilite en declarant avoir vu la piece.
  identiteVerifieeLe DateTime?
  idVerifiePar       String?
  verifiePar         Utilisateur? @relation("IdentitesVerifiees", fields: [idVerifiePar], references: [id], onDelete: SetNull)

  /// Le dossier dans lequel celui-ci a ete fusionne (EF-01-06).
  ///
  /// **Le dossier absorbe n'est jamais supprime.** Il garde son identifiant,
  /// son code QR et son compte : une personne qui presente son ancienne carte
  /// doit etre retrouvee, et une fusion doit pouvoir etre defaite. Il est
  /// simplement ecarte des recherches, et les lectures suivent ce lien.
  ///
  /// `Restrict` : on ne supprime pas un dossier qui en absorbe un autre.
  idFusionneDans String?
  fusionneDans   PatientProfile?  @relation("FusionDeDossier", fields: [idFusionneDans], references: [id], onDelete: Restrict)
  dossiersAbsorbes PatientProfile[] @relation("FusionDeDossier")
  fusionneLe     DateTime?

  evenementsConsentement EvenementConsentement[]

  fusionsPrincipal FusionDossier[] @relation("FusionPrincipal")
  fusionsAbsorbe   FusionDossier[] @relation("FusionAbsorbe")
  // Maille reelle du parcours commande/livraison : c'est dans son quartier que
  // le patient cherche une pharmacie, pas dans sa prefecture.
  commune            String?
  quartier           String?
  village            String?
  latitude           Float?
  longitude          Float?
  photoUrl           String?
  urgenceNom         String?
  urgenceTelephone   String?
  creeLe             DateTime     @default(now())
  modifieLe          DateTime     @updatedAt

  idUtilisateur String      @unique
  utilisateur   Utilisateur @relation(fields: [idUtilisateur], references: [id], onDelete: Restrict)

  // â”€â”€ MODELE HYBRIDE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  // Structure prÃ©fÃ©rÃ©e choisie par le patient (optionnel)
  demandesRendezVous DemandeRendezVous[]

  idStructurePreferee String?
  structurePreferee   StructureSante? @relation("StructurePreferee", fields: [idStructurePreferee], references: [id])

  // ASC attitrÃ© du patient (optionnel)
  idAscPrincipal String?
  ascPrincipal   AscProfile? @relation("PatientAscPrincipal", fields: [idAscPrincipal], references: [id])

  consultations        Consultation[]
  vaccinations         Vaccination[]
  factures             Facture[]
  ventesComptoir       VenteComptoir[]
  contratsAssurance    ContratAssurance[]
  controlesEligibilite ControleEligibilite[]
  rendezVous           RendezVous[]
  consentements        ConsentementPatient[]
  /// Les acces a son dossier, qu'il peut consulter lui-meme (EF-02-08).
  accesAuDossier       JournalAudit[]        @relation("AccesAuDossier")
  /// Ses demandes d'exercice de droits (EF-12-09).
  demandesRgpd         DemandeRgpd[]
  episodes             EpisodeSoins[]
  demandesAnalyse      DemandeAnalyse[]

  @@index([prefecture])
  @@index([idStructurePreferee])
  @@index([idAscPrincipal])
  /// Ces deux index existaient en SQL sans etre declares ici : chaque
  /// `migrate diff` proposait donc de les supprimer. Les declarer evite qu'une
  /// prochaine migration les emporte en silence.
  @@index([dateNaissance, lieuNaissance], map: "patients_traits_distinctifs_idx")
  @@index([niveauIdentite], map: "patients_niveau_identite_idx")
  @@map("patients")
}

