{
  "name": "@baobaoheath/api",
  "version": "1.0.0",
  "description": "BaoBaoHealth Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest --config jest.config.cjs --passWithNoTests",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma.config.ts",
    "prisma:studio": "prisma studio --config prisma.config.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:e2e": "tsx prisma/seed-e2e.ts",
    "prisma:seed:demo": "tsx prisma/seed-demo.ts",
    "prisma:seed:consentements": "tsx prisma/seed-textes-consentement.ts",
    "prisma:backfill-encryption": "tsx prisma/backfill-encryption.ts"
  },
  "dependencies": {
    "@baobaoheath/shared-types": "*",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@sentry/node": "^10.61.0",
    "@types/multer": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.16.0",
    "rate-limit-redis": "^4.2.0",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.11",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.5.2",
    "prisma": "^7.5.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
